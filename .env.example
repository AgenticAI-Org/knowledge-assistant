# Copy this file to .env and fill in your own key. Never commit .env.

# Required: OpenAI API key used for embeddings, generation, and query condensation.
OPENAI_API_KEY=sk-...

# Optional overrides -- defaults live in src/config.py
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

CHUNK_SIZE=400
CHUNK_OVERLAP=80

TOP_K_VECTOR=10
TOP_K_BM25=10
TOP_K_RERANK=4
# Wider window for 'summarise/list/overview' style queries.
TOP_K_RERANK_BROAD=12
# k at which all three retrieval methods are compared in the eval.
EVAL_TOP_K=4
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

LOG_LEVEL=INFO
LOG_JSON=true
